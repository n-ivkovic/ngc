# MACRO parameter key references are case-insensitive

%MACRO macro.UPPER UPPER
A = UPPER
A = upper
A = Upper
A = uPpEr
%END
%MACRO macro.lower lower
A = LOWER
A = lower
A = Lower
A = lOwEr
%END
%MACRO macro.mIxEd mIxEd
A = MIXED
A = mixed
A = Mixed
A = mIxEd
%END

macro.UPPER 0x5550
macro.lower 0x6C6F
macro.mIxEd 0x4D69

# MACRO parameter key supports '.' char in any position

%MACRO macro.. .
A = .
%END
%MACRO macro... ..
A = ..
%END
%MACRO macro.X. X.
A = X.
%END
%MACRO macro.X.. X..
A = X..
%END
%MACRO macro..X .X
A = .X
%END
%MACRO macro...X ..X
A = ..X
%END

macro.. 0x002E
macro... 0x2E2E
macro.X. 0x582E
macro.X.. 0x582F
macro..X 0x2E58
macro...X 0x2F58

# MACRO parameter key definition can overlap with hex number
# MACRO parameter key reference can conflict with hex number: Hex number takes precedence

%MACRO macro.x0 x0
A = X0
A = x0
%END
%MACRO macro.x00 x00
A = X00
A = x00
%END
%MACRO macro.xF xF
A = xF
A = XF
A = xf
%END
%MACRO macro.xFF xFF
A = xFF
A = XFF
A = xff
%END
%MACRO macro.x_ x_
A = x_
A = X_
%END
%MACRO macro.x__ x_
A = x__
A = X__
%END

macro.x0 0x01
macro.x00 0x02
macro.xF 0xF1
macro.xFF 0xF2
macro.x_ 0x5F
macro.x__ 0x5F5F

# MACRO parameter key definition can overlap with binary number
# MACRO parameter key reference can conflict with binary number: Binary number takes precedence

%MACRO macro.b0 b0
A = B0
A = b0
%END
%MACRO macro.b00 b00
A = B00
A = b00
%END
%MACRO macro.b1 b1
A = B1
A = b1
%END
%MACRO macro.b11 b11
A = B11
A = b11
%END
%MACRO macro.b_ b_
A = B_
A = b_
%END
%MACRO macro.b__ b__
A = B__
A = b__
%END

macro.b0 0xB01
macro.b00 0xB02
macro.b1 0xB11
macro.b11 0xB12
macro.b_ 0x5F
macro.b__ 0x5F5F

# MACRO parameter key definition cannot overlap with ALU operation:
# - ALU operation can only be UPPER CASE
# - MACRO parameter key cannot be UPPER CASE ALU operation
# MACRO parameter key reference can conflict with ALU operation: ALU operation takes precedence

%MACRO macro.a a
A = A
A = a
%END
%MACRO macro.d d
A = D
A = d
%END

macro.a 0xA
macro.d 0xD

# MACRO parameter key definition can overlap with ALU jump condition
# MACRO parameter key reference can conflict with ALU jump condition: ALU jump condition takes precedence
# - ALU jump operation can only be UPPER CASE
# - MACRO parameter key reference can conflict with ALU jump condition only when UPPER CASE

%MACRO macro.JGT JGT
A = jgt
A = Jgt
A = jGT
%END
%MACRO macro.JEQ JEQ
A = jeq
A = Jeq
A = jEQ
%END
%MACRO macro.JGE JGE
A = jge
A = Jge
A = jGE
%END
%MACRO macro.JLT JLT
A = jlt
A = Jlt
A = jLT
%END
%MACRO macro.JNE JNE
A = jne
A = Jne
A = jNE
%END
%MACRO macro.JLE JLE
A = jle
A = Jle
A = jLE
%END
%MACRO macro.JMP JMP
A = jmp
A = Jmp
A = jMP
%END

macro.JGT 0x4754
macro.JEQ 0x4551
macro.JGE 0x4745
macro.JLT 0x4C54
macro.JNE 0x4E45
macro.JLE 0x4C45
macro.JMP 0x4D50
