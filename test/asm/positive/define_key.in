# DEFINE key references are case-insensitive

DEFINE UPPER 0x5550
DEFINE lower 0x6C6F
DEFINE mIxEd 0x4D69

A = UPPER
A = upper
A = Upper
A = uPpEr
A = LOWER
A = lower
A = Lower
A = lOwEr
A = MIXED
A = mixed
A = Mixed
A = mIxEd

# DEFINE key supports '.' char in any position

DEFINE . 0x002E
DEFINE .. 0x2E2E
DEFINE X. 0x582E
DEFINE X.. 0x582F
DEFINE .X 0x2E58
DEFINE ..X 0x2F58

A = .
A = ..
A = X.
A = X..
A = .X
A = ..X

# DEFINE key definition can overlap with hex number
# DEFINE key reference can conflict with hex number: Hex number takes precedence

DEFINE x0 0x01
DEFINE x00 0x02
DEFINE xF 0xF1
DEFINE xFF 0xF2
DEFINE x_ 0x5F
DEFINE x__ 0x5F5F

A = X0
A = x0
A = xF
A = XF
A = xf
A = X_
A = x_
A = X__
A = x__

# DEFINE key definition can overlap with binary number
# DEFINE key reference can conflict with binary number: Binary number takes precedence

DEFINE b0 0xB01
DEFINE b00 0xB02
DEFINE b1 0xB11
DEFINE b11 0xB12
DEFINE b_ 0x5F
DEFINE b__ 0x5F5F

A = B0
A = b0
A = B00
A = b00
A = B1
A = b1
A = B11
A = b11
A = B_
A = b_
A = B__
A = b__

# DEFINE key definition cannot overlap with ALU operation:
# - ALU operation can only be UPPER CASE
# - DEFINE key cannot be UPPER CASE ALU operation
# DEFINE key reference can conflict with ALU operation: ALU operation takes precedence

DEFINE a 0xA
DEFINE d 0xD

A = A
A = a
A = D
A = d

# DEFINE key definition can overlap with ALU jump condition
# DEFINE key reference can conflict with ALU jump condition: ALU jump condition takes precedence
# - ALU jump operation can only be UPPER CASE
# - DEFINE key reference can conflict with ALU jump condition only when UPPER CASE

DEFINE JGT 0x4754
DEFINE JEQ 0x4551
DEFINE JGE 0x4745
DEFINE JLT 0x4C54
DEFINE JNE 0x4E45
DEFINE JLE 0x4C45
DEFINE JMP 0x4D50

A = jgt
A = Jgt
A = jGT
A = jeq
A = Jeq
A = jEQ
A = jge
A = Jge
A = jGE
A = jlt
A = Jlt
A = jLT
A = jne
A = Jne
A = jNE
A = jle
A = Jle
A = jLE
A = jmp
A = Jmp
A = jMP
