# MACRO key references are case-insensitive

%MACRO UPPER
A = 0x5550
%END
%MACRO lower
A = 0x6C6F
%END
%MACRO mIxEd
A = 0X4D69
%END

UPPER
upper
Upper
uPpEr
LOWER
lower
Lower
lOwEr
MIXED
mixed
Mixed
mIxEd

# MACRO key supports '.' char in any position

%MACRO .
A = 0x002E
%END
%MACRO ..
A = 0x2E2E
%END
%MACRO X.
A = 0x582E
%END
%MACRO X..
A = 0x582F
%END
%MACRO .X
A = 0x2E58
%END
%MACRO ..X
A = 0x2F58
%END

.
..
X.
X..
.X
..X

# MACRO key can be hex number

%MACRO x0
A = 0x01
%END
%MACRO x00
A = 0x02
%END
%MACRO xF
A = 0xF1
%END
%MACRO xFF
A = 0xF2
%END
%MACRO x_
A = 0x5F
%END
%MACRO x__
A = 0x5F5F
%END

x0
x00
xF
xFF
x_
x__

# MACRO key can be binary number

%MACRO b0
A = 0xB01
%END
%MACRO b00
A = 0xB02
%END
%MACRO b1
A = 0xB11
%END
%MACRO b11
A = 0xB12
%END
%MACRO b_
A = 0x5F
%END
%MACRO b__
A = 0x5F5F
%END

b0
b00
b1
b11
b_
b__

# MACRO key definition cannot conflict with ALU operation
# - ALU operation can only be UPPER CASE
# - MACRO parameter key cannot be UPPER CASE ALU operation
# When referenced, ALU operation takes precedence if it conflicts with a MACRO parameter key

%MACRO a
A = 0xA
%END
%MACRO d
A = 0xD
%END

A
a
D
d

# MACRO key definition can conflict with ALU jump condition:
# - ALU jump condition can only be UPPER CASE
# - MACRO key can be UPPER CASE ALU jump condition
# When referenced, ALU jump condition takes precedence if it conflicts with a MACRO key

%MACRO JGT
A = 0x4754
%END
%MACRO JEQ
A = 0x4551
%END
%MACRO JGE
A = 0x4745
%END
%MACRO JLT
A = 0x4C54
%END
%MACRO JNE
A = 0x4E45
%END
%MACRO JLE
A = 0x4C45
%END
%MACRO JMP
A = 0x4D50
%END

jgt
Jgt
jGT
jeq
Jeq
jEQ
jge
Jge
jGE
jlt
Jlt
jLT
jne
Jne
jNE
jle
Jle
jLE
jmp
Jmp
jMP

# Only ALU jump condition that can conflict with MACRO key
JMP

# MACRO key cannot conflict with DEFINE key

%MACRO shared.define
D&A
A = shared.define
%END

DEFINE shared.define 12345
A = shared.define
shared.define

# MACRO key cannot conflict with LABEL key

%MACRO shared.label
D&A
A = shared.label
%END

LABEL shared.label
A = shared.label
shared.label
