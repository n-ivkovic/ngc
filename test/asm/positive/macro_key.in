# MACRO key references are case-insensitive

%MACRO UPPER
	A = 0x5550
%END
%MACRO lower
	A = 0x6C6F
%END
%MACRO mIxEd
	A = 0X4D69
%END

UPPER
upper
Upper
uPpEr
LOWER
lower
Lower
lOwEr
MIXED
mixed
Mixed
mIxEd

# MACRO key supports '.' char in any position

%MACRO .
	A = 0x002E
%END
%MACRO ..
	A = 0x2E2E
%END
%MACRO X.
	A = 0x582E
%END
%MACRO X..
	A = 0x582F
%END
%MACRO .X
	A = 0x2E58
%END
%MACRO ..X
	A = 0x2F58
%END

.
..
X.
X..
.X
..X

# MACRO key definition can start with alpha-prefixed number (b, x)
# MACRO key reference can conflict with invalid number if MACRO key starts with alpha-prefixed number (b, x): Invalid number takes precedence

%MACRO b2
	A = 0xB2
%END
%MACRO b20
	A = 0xB20
%END
%MACRO xg
	A = 0x47
%END
%MACRO xg0
	A = 0x470
%END

b2
b20
xg
xg0

# MACRO key definition cannot overlap with ALU operation
# - ALU operation can only be UPPER CASE
# - MACRO parameter key cannot be UPPER CASE ALU operation
# MACRO key reference can conflict with ALU operation: ALU operation takes precedence

%MACRO a
	A = 0xA
%END
%MACRO d
	A = 0xD
%END

A
a
D
d

# MACRO key definition can overlap with ALU jump condition
# MACRO key reference can conflict with ALU jump condition: ALU jump condition takes precedence
# - ALU jump operation can only be UPPER CASE
# - MACRO key reference can conflict with ALU jump condition only when UPPER CASE

%MACRO JGT
	A = 0x4754
%END
%MACRO JEQ
	A = 0x4551
%END
%MACRO JGE
	A = 0x4745
%END
%MACRO JLT
	A = 0x4C54
%END
%MACRO JNE
	A = 0x4E45
%END
%MACRO JLE
	A = 0x4C45
%END
%MACRO JMP
	A = 0x4D50
%END

jgt
Jgt
jGT
jeq
Jeq
jEQ
jge
Jge
jGE
jlt
Jlt
jLT
jne
Jne
jNE
jle
Jle
jLE
jmp
Jmp
jMP

# Only ALU jump condition that can conflict with MACRO key reference
JMP

# MACRO key definition and reference can overlap with DEFINE key

%MACRO shared.define
	D&A
	A = shared.define
%END

DEFINE shared.define 12345
A = shared.define
shared.define

# MACRO key definition and reference can overlap with LABEL key

%MACRO shared.label
	D&A
	A = shared.label
%END

LABEL shared.label
A = shared.label
shared.label
